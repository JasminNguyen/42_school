{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/philo",  // Update with your executable path
            "args": ["20", "900", "200", "200", "2"],  // Command line arguments to pass to your program
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",  // Update with your build task name
            "miDebuggerPath": "/usr/bin/gdb",  // Update with your GDB executable path
            "miDebuggerArgs": "",
            "showDisplayString": true
        }
    ]
}
